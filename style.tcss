/* Scicher — stylesheet for the main app and its modal dialogs (science-dark / science-light themes). */

/* Keep scrolling (keyboard/wheel) working everywhere, just hide the visible bar. */
* {
    scrollbar-visibility: hidden;
}

Screen {
    background: $background;
    scrollbar-color: $primary;
    scrollbar-background: $surface;
}

Header {
    background: $background;
    color: $primary;
    text-style: bold;
}

Footer {
    background: $background;
}

FooterKey {
    background: $background;
    color: $foreground;
}

FooterKey .footer-key--key {
    color: $primary;
    text-style: bold;
}

FooterKey.-command-palette {
    background: $background;
    color: $secondary;
}

FooterKey.-command-palette .footer-key--key {
    color: $secondary;
}

/* Compact command palette (ctrl+p), anchored near the top so a long result list
   (e.g. the theme picker) grows downward and scrolls instead of overflowing past
   the bottom of the screen. */
CommandPalette {
    align: center top;
    background: $background 70%;
}

CommandPalette > Vertical {
    margin-top: 2;
    width: 90;
    height: auto;
    border: thick $secondary;
    background: $surface;
}

CommandPalette #--input {
    border: hkey $secondary 50%;
}

CommandList {
    max-height: 60vh;
}

#main_area {
    height: 1fr;
    padding: 0 1;
}

#results_section {
    height: 1fr;
    margin-bottom: 1;
}

#bottom_row {
    height: 1fr;
}

#left_col, #detail_section {
    width: 1fr;
    height: 1fr;
}

#left_col {
    margin-right: 1;
}

#query_panel, #query_section, #results_section, #detail_section {
    height: 1fr;
    border: round $primary;
    background: $panel;
    padding: 0 1;
    border-title-color: $primary;
    border-title-style: bold;
    border-title-align: left;
    border-subtitle-color: $secondary;
    border-subtitle-align: right;
}

#query_panel {
    margin-bottom: 1;
}

#query_section, #detail_section {
    border: round $secondary;
    border-title-color: $secondary;
    border-subtitle-color: $primary;
}

#groups_list {
    height: 1fr;
    background: $surface;
}

#query_preview_scroll {
    height: 1fr;
    background: $surface;
    padding: 0 0 0 1;
}

#query_preview {
    color: $foreground;
}

#groups_list:focus, #query_preview_scroll:focus, #detail_scroll:focus, #results_table:focus {
    background-tint: $accent 10%;
}

Button {
    border: tall $primary;
    background: $surface;
    color: $primary;
    text-style: bold;
}

Button:hover, Button.-primary:hover {
    border: tall $accent;
    background: $primary 25%;
    color: $foreground;
}

Button:focus, Button.-primary:focus {
    border: tall $accent;
    background: $primary 85%;
    color: $background;
    text-style: bold;
}

#results_table {
    height: 1fr;
    background: $surface;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent 35%;
    color: $foreground;
}

#detail_scroll {
    height: 1fr;
    background: $surface;
    padding: 0 0 0 1;
}

#detail_text {
    color: $foreground;
}

#status {
    width: 100%;
    height: auto;
    color: $primary;
    background: $panel;
    border: round $primary 30%;
    padding: 0 1;
    margin-top: 1;
}

#search_progress {
    display: none;
    width: 100%;
    height: auto;
    margin-top: 1;
}

#search_progress Bar {
    width: 1fr;
}

#search_progress Bar > .bar--bar {
    color: $accent;
    background: $surface;
}

#search_progress Bar > .bar--complete {
    color: $secondary;
    background: $surface;
}

#search_progress PercentageStatus {
    color: $foreground;
    text-style: bold;
}

/* Modal dialogs (AddTermScreen, ExportCsvScreen, QueryLogScreen, FiltersScreen, LoadQueryScreen, ArticleActionsScreen) */

AddTermScreen, ExportCsvScreen, QueryLogScreen, FiltersScreen, LoadQueryScreen, ArticleActionsScreen,
SettingsScreen {
    align: center middle;
}

#dialog, #export_dialog, #log_dialog, #actions_dialog, #settings_dialog {
    width: 70;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#actions_dialog {
    width: 88;
}

#settings_dialog {
    width: 80;
}

#settings_dialog Input {
    margin-bottom: 1;
}

#actions_title {
    width: 100%;
    height: auto;
    color: $foreground;
    text-style: italic;
    margin-top: 1;
}

#actions_access {
    color: $success;
    text-style: bold;
    margin-top: 1;
}

#actions_dialog Horizontal {
    height: auto;
    margin-top: 1;
}

#actions_dialog Button {
    margin-right: 1;
}

#dialog Select, #dialog Input, #dialog Horizontal,
#export_dialog Input, #export_dialog Horizontal,
#log_dialog Input, #log_dialog Horizontal {
    margin-top: 1;
}

#filters_dialog {
    width: 74;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#filters_dialog Horizontal, #filters_dialog SelectionList,
#filters_dialog Select, #filters_dialog Checkbox {
    margin-top: 1;
}

#year_row Input {
    width: 1fr;
    margin-right: 1;
}

#year_row Input:last-child {
    margin-right: 0;
}

#pub_types {
    height: 10;
    border: round $primary 30%;
}

#load_dialog {
    width: 100;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#load_path_row {
    height: auto;
    margin-top: 1;
}

#load_path_row Input {
    width: 1fr;
    margin-right: 1;
}

#load_dialog > Horizontal:last-child {
    margin-top: 1;
}

#log_entries {
    height: 14;
    margin-top: 1;
    background: $surface;
    border: round $primary 30%;
}
